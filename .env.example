# ============================================================
# Cinematic Romantic Gift Website — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Standard Vite prefix (import.meta.env.VITE_*)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Legacy Next.js prefix (injected via vite.config.ts define)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# !! SECURITY: Service Role Key bypasses ALL RLS — NEVER expose in client code !!
# Use ONLY in server-side edge functions or admin CLI scripts.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Firebase (Google Sign-In) ────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Razorpay Payment Gateway ─────────────────────────────────
# Use rzp_test_* keys for development/testing, rzp_live_* for production
VITE_RAZORPAY_KEY_ID=rzp_test_your-key-id-here
# !! SECURITY: KEY_SECRET must NEVER go in client-side code — verify signatures server-side !!
# RAZORPAY_KEY_SECRET=your-key-secret-here
